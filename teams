#!/usr/bin/env sh
# Unix launcher for teams (analogous to teams.cmd on Windows).
#
# Uses prebuilt release binary if present, attempts `gh release download` from
# BiteFoundry/teams when available, and falls back to `cargo build --release`.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
TARGET_DIR=${CARGO_TARGET_DIR:-"$ROOT/target"}
BIN="$TARGET_DIR/release/teams"

if [ ! -x "$BIN" ] && command -v gh >/dev/null 2>&1; then
    OS=$(uname -s)
    ARCH=$(uname -m)
    TRIPLE=""
    case "$OS-$ARCH" in
        Darwin-arm64) TRIPLE="aarch64-apple-darwin" ;;
        Darwin-x86_64) TRIPLE="x86_64-apple-darwin" ;;
        Linux-x86_64) TRIPLE="x86_64-unknown-linux-gnu" ;;
        Linux-aarch64|Linux-arm64) TRIPLE="aarch64-unknown-linux-gnu" ;;
    esac
    if [ -n "$TRIPLE" ]; then
        mkdir -p "$TARGET_DIR/release"
        TMP_TGZ="$TARGET_DIR/release/teams-$TRIPLE.tar.gz"
        if gh release download -R BiteFoundry/teams --pattern "teams-*-$TRIPLE.tar.gz" -O "$TMP_TGZ" --clobber >/dev/null 2>&1; then
            tar -xzf "$TMP_TGZ" -C "$TARGET_DIR/release" >/dev/null 2>&1 || true
            rm -f "$TMP_TGZ"
            [ -f "$BIN" ] && chmod +x "$BIN"
        fi
    fi
fi

if [ ! -x "$BIN" ]; then
    echo "[teams] release build not found - building..." >&2
    cargo build --release --manifest-path "$ROOT/Cargo.toml" >&2
fi

exec "$BIN" "$@"
